# Data (pulled/generated locally — not committed)
data/raw/
data/processed/
*.parquet
*.csv
!config/*.csv
# Manual-data exception (Step 9c): tiny, static, hand-curated — the repo's source of truth.
!data/manual/*.csv

# Secrets (Step 19 / the ESPN draft feed). NOTE: config/ is COMMITTED — never put
# credentials there. espn_s2 + SWID are live session cookies for a personal ESPN/Disney
# account: they authenticate as the user, so they are read from the environment or this
# gitignored file only, are never logged, and are never echoed into a report or a payload
# fixture (scrub them when recording tests/fixtures/espn_draft_*.json).
.env
.env.*
espn_auth.json

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/
.ipynb_checkpoints/

# Frontend (frontend/dist is covered by dist/ above)
node_modules/
frontend/.vite/

# Tooling
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Claude Code local settings (machine-specific)
.claude/settings.local.json

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/

# TypeScript incremental build state
*.tsbuildinfo

# Ad-hoc board export (regenerate with scripts/export_rankings_html.py)
/fpts_rankings.html

# Stray root lockfile — the only JS package root is frontend/
/package-lock.json

